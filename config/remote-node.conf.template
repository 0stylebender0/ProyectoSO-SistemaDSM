# Plantilla de configuracion para un nodo DSM en otra maquina.
# scripts/demo_remote.sh reemplaza los valores @...@. Para uso manual,
# copie este archivo, sustituya los marcadores y revise las notas de
# docs/remote.md antes de iniciar el nodo.
[general]
node_name=@NODE_NAME@
memory_size=33554432
page_size=4096

[network]
# Debe ser la IPv4 de esta maquina alcanzable por los demas participantes.
# No use 0.0.0.0 en un cluster remoto: el nodo anunciaria 127.0.0.1.
bind_address=@BIND_ADDRESS@
tcp_port=@TCP_PORT@
# UDP del heartbeat. Puede ser 0 para que el SO asigne uno efimero, pero
# en un cluster conviene fijarlo y abrirlo en el firewall.
heartbeat_port=@HEARTBEAT_PORT@

[discovery]
# IP:puerto TCP del nodo semilla. En el primer nodo puede quedar vacio.
bootstrap_nodes=@BOOTSTRAP_NODES@
# Todas las maquinas participantes, separadas por coma, con su puerto TCP.
# Se prueban como semillas en orden hasta que una incorpore al nodo.
node_addresses=@NODE_ADDRESSES@

[heartbeat]
interval_ms=1000
timeout_ms=5000

[network_workers]
worker_count=4
max_connections=64

[paging]
request_timeout_ms=5000
